# ===== assistantai backend environment =====
# Copy to .env and fill in your values.

# Flask
SECRET_KEY=change-this-secret
FLASK_ENV=development
PORT=5001

# Admin SQLite (settings, conversations, audit, training metadata)
ADMIN_DB_URL=sqlite:////app/data/assistantai.db

# Source database to query with text-to-SQL (Postgres/MySQL/SQLite)
SOURCE_DB_URL=postgresql+psycopg2://postgres:admin@localhost:5432/postgres

# ===== MICROSERVICE MODE (optional) =====
# Set to 'true' to run as a microservice that trusts tokens from your main auth server
# See docs/MICROSERVICE_SETUP.md for full guide
MICROSERVICE_MODE=false

# Token validation strategy (choose ONE):

# Strategy 1: HS256 with shared secret
# MICROSERVICE_TOKEN_SECRET=your-shared-secret-key
# MICROSERVICE_TOKEN_ALGORITHM=HS256

# Strategy 2: RS256 with public key
# MICROSERVICE_TOKEN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----
# MICROSERVICE_TOKEN_ALGORITHM=RS256

# Strategy 3: OAuth2/OIDC token introspection
# MICROSERVICE_TOKEN_INTROSPECTION_URL=https://your-auth-server/oauth/introspect

# Default LLM provider
# One of: gemini | openai | anthropic | huggingface
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Cloud LLM API keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Free offline Hugging Face LLM =====
# Used when LLM_PROVIDER=huggingface (runs locally via transformers).
HF_MODEL=google/flan-t5-base
HF_MAX_NEW_TOKENS=512
# Force fully offline (model must already be cached): 1 to enable
TRANSFORMERS_OFFLINE=0

# ===== Vector store for Vanna training/retrieval =====
# One of: chromadb | faiss | pinecone
VECTOR_STORE=chromadb
CHROMA_PATH=/app/data/vanna_chroma
FAISS_PATH=/app/data/vanna_faiss

# Pinecone (only if VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=assistantai
PINECONE_ENVIRONMENT=

# Embeddings used by the vector store (sentence-transformers, offline-capable)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== Guest Account (Demo/Testing) =====
# Default guest user credentials for limited access testing
GUEST_EMAIL=guest@guest.com
GUEST_PASSWORD=Guest123
GUEST_USERNAME=guest

# Docs path inside container (compose also mounts ./docs:/docs)
DOCS_FOLDER=/docs
# Writable home for appuser (uploads/caches). Required when useradd --no-create-home
HOME=/app/data
HF_HOME=/app/data/huggingface
